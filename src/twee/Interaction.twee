:: Interaction
<div id="twee-interaction-container"></div>
<<script>>
  $(document).one(':passageend', function() {
    if (window.setup && window.setup.Lineage) {
      const state = {
        $world: State.variables.world,
        $playerId: State.variables.playerId,
        $actors: State.variables.actors,
        $unions: State.variables.unions,
        $chronicle: State.variables.chronicle
      };
      const container = document.getElementById('twee-interaction-container');
      const targetId = State.variables.selectedInteractionActorId;
      if (container) {
        window.setup.Lineage.renderInteractionView(container, state, targetId, function() {
          Engine.play("Hub");
        });
      }
    }
  });
<</script>>
